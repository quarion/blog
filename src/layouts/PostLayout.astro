---
import BaseLayout from "./BaseLayout.astro";
import { postPath } from "../lib/site";

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  slug: string;
  historicalDiscussion?: boolean;
}

const { title, description, publishedAt, slug, historicalDiscussion = false } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(publishedAt);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={postPath(slug)}
  type="article"
>
  <article class="post">
    <header class="post-header">
      <h1>{title}</h1>
      <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
    </header>
    <div class="prose">
      <slot />
    </div>
    {
      historicalDiscussion && (
        <aside class="historical-discussion" aria-labelledby="historical-discussion">
          <h2 id="historical-discussion">Historical discussion</h2>
          <p>
            This article had three Disqus comments in 2016. Their verbatim text will be imported
            from the public archive during source recovery; no Disqus scripts or trackers are
            loaded here.
          </p>
        </aside>
      )
    }
  </article>
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { postPath } from "../lib/site";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout>
  <section class="intro">
    <h1>Notes on building software</h1>
    <p>
      A public notebook about software design, architecture, and the practical work of making
      systems easier to understand.
    </p>
  </section>
  <section aria-labelledby="articles">
    <h2 id="articles" class="section-title">Articles</h2>
    <ol class="post-list">
      {
        posts.map(({ data }) => (
          <li>
            <article>
              <h3><a href={postPath(data.slug)}>{data.title}</a></h3>
              <time datetime={data.publishedAt.toISOString()}>
                {new Intl.DateTimeFormat("en", {
                  day: "numeric",
                  month: "short",
                  year: "numeric",
                }).format(data.publishedAt)}
              </time>
              <p>{data.description}</p>
            </article>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

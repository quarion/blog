{
  "name": "quarion-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "verify": "node scripts/verify-build.mjs",
    "test": "npm run check && npm run build && npm run verify"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "cross-env": "10.1.0",
    "typescript": "6.0.3"
  }
}
